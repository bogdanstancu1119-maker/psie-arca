+#!/usr/bin/env python3
+"""Script pentru arhivarea alertelor brute în R2 și setarea modului de sinteză.
+"""
+
+import json
+import os
+import requests
+
+# Date brute ale alertelor (preluate din sistem)
+RAW_DATA = {
+    "organ_emitator": "hydraSincronizareSymbiote",
+    "payload": "ALERTĂ: Obezitatea informațională blochează coerența. Trecere imediată la modul Sinteză 80/0/20.",
+    "rezultat_rutare": None,
+    "procesat_de": None,
+    "tip_signal": "alert",
+    "prioritate": "critica",
+    "organ_tinta": None,
+    "status": "nou",
+    "id": "6a886f24378b4249aef4d305",
+    "created_date": "2026-08-21T15:30:44.870000",
+    "updated_date": "2026-08-21T15:30:44.870000",
+    "created_by_id": "service_bb678f46-2cd4-457f-917c-91010ac896a1",
+    "created_by": "service+bb678f46-2cd4-457f-917c-91010ac896a1@no-reply.base44.com",
+    "is_sample": False
+}
+
+# Configurație R2 (variabile de mediu)
+R2_ENDPOINT = os.getenv("R2_ENDPOINT", "https://r2.example.com")
+R2_BUCKET = os.getenv("R2_BUCKET", "hydra-archives")
+R2_TOKEN = os.getenv("R2_TOKEN")  # Trebuie setată în mediul de execuție
+
+def archive_to_r2(data: dict, filename: str) -> None:
+    """Arhivează un obiect JSON în R2."""
+    url = f"{R2_ENDPOINT}/{R2_BUCKET}/{filename}"
+    headers = {"Authorization": f"Bearer {R2_TOKEN}"}
+    response = requests.put(url, headers=headers, json=data)
+    response.raise_for_status()
+    print(f"Arhivat în R2: {url}")
+
+def update_mode_in_config() -> None:
+    """Actualizează fișierul config.yaml pentru a seta modul de sinteză."""
+    config_path = "config.yaml"
+    with open(config_path, "r", encoding="utf-8") as f:
+        lines = f.readlines()
+    with open(config_path, "w", encoding="utf-8") as f:
+        for line in lines:
+            if line.startswith("mode:"):
+                f.write("mode: sintetica_80_0_20\n")
+            else:
+                f.write(line)
+    print(f"Actualizat {config_path} la modul sintetica_80_0_20")
+
+if __name__ == "__main__":
+    # Arhivare în R2
+    archive_to_r2(RAW_DATA, "alert_6a886f24378b4249aef4d305.json")
+    # Actualizare mod
+    update_mode_in_config()
